---
/**
 * Header.astro — fixed glassmorphism navbar.
 * Primary CTA: Book the Bar -> #contact. WhatsApp lives in the floating bubble.
 */
---

<header id="siteNav" class="fixed inset-x-0 top-0 z-50">
  <div class="mx-auto max-w-7xl px-4 pt-4 lg:px-8">
    <div class="nav-shell flex items-center justify-between rounded-2xl border border-white/10 bg-black/35 px-4 py-3 backdrop-blur-xl md:px-6">
      <!-- Logo -->
      <a href="#hero" class="group flex items-center" aria-label="ROAM SOCIAL — Home">
        <img
          src="/images/roam-logo.png"
          alt="ROAM SOCIAL logo"
          fetchpriority="high"
          decoding="async"
          class="h-10 w-auto md:h-12"
        />
      </a>

      <!-- Desktop links -->
      <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
        <a href="#menu" class="nav-link">Menu</a>
        <a href="#gallery" class="nav-link">Gallery</a>
        <a href="#contact" class="nav-link">Contact</a>
        <a href="#instagram" class="nav-link">Instagram</a>
        <a href="#contact" class="btn-gold !px-5 !py-3 !text-[11px]">
          <i class="fa-solid fa-calendar-check text-sm" aria-hidden="true"></i> Book the Bar
        </a>
      </nav>

      <!-- Mobile toggle -->
      <button
        id="menuBtn"
        class="grid h-11 w-11 place-items-center rounded-full border border-white/15 text-white/80 transition hover:border-gold/60 hover:text-gold md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
    </div>

    <!-- Mobile panel -->
    <div id="mobileMenu" class="mobile-panel md:hidden">
      <div class="mt-3 rounded-2xl border border-white/10 bg-black/85 p-4 backdrop-blur-xl">
        <nav class="flex flex-col" aria-label="Mobile">
          <a href="#menu" class="mobile-link border-b border-white/5 py-3.5 text-sm tracking-[.14em] text-white/75 transition hover:text-gold">MENU</a>
          <a href="#gallery" class="mobile-link border-b border-white/5 py-3.5 text-sm tracking-[.14em] text-white/75 transition hover:text-gold">GALLERY</a>
          <a href="#contact" class="mobile-link border-b border-white/5 py-3.5 text-sm tracking-[.14em] text-white/75 transition hover:text-gold">CONTACT</a>
          <a href="#instagram" class="mobile-link border-b border-white/5 py-3.5 text-sm tracking-[.14em] text-white/75 transition hover:text-gold">INSTAGRAM</a>
        </nav>
        <a href="#contact" class="btn-gold mobile-link mt-4 w-full !py-3.5 !text-[11px]">
          <i class="fa-solid fa-calendar-check" aria-hidden="true"></i> Book the Bar
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var menuBtn = document.getElementById("menuBtn");
    var mobileMenu = document.getElementById("mobileMenu");
    if (!menuBtn || !mobileMenu) return;

    var barsIcon = '<i class="fa-solid fa-bars" aria-hidden="true"></i>';
    var xIcon = '<i class="fa-solid fa-xmark" aria-hidden="true"></i>';

    function closeMobile() {
      mobileMenu.classList.remove("open");
      menuBtn.innerHTML = barsIcon;
      menuBtn.setAttribute("aria-expanded", "false");
    }

    menuBtn.addEventListener("click", function () {
      var open = mobileMenu.classList.toggle("open");
      menuBtn.innerHTML = open ? xIcon : barsIcon;
      menuBtn.setAttribute("aria-expanded", String(open));
    });

    mobileMenu.querySelectorAll("a").forEach(function (a) {
      a.addEventListener("click", closeMobile);
    });

    // Close the open menu as soon as the user scrolls without selecting an option
    var isOpen = function () {
      return mobileMenu.classList.contains("open");
    };
    var onMenuCloseScroll = function () {
      if (isOpen()) closeMobile();
    };
    window.addEventListener("scroll", onMenuCloseScroll, { passive: true });
    window.addEventListener("touchmove", onMenuCloseScroll, { passive: true });
    window.addEventListener("wheel", onMenuCloseScroll, { passive: true });
    document.addEventListener("keydown", function (e) {
      if (!isOpen()) return;
      var scrollKeys = ["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Space", "Home", "End"];
      if (scrollKeys.indexOf(e.key) !== -1) closeMobile();
      if (e.key === "Escape") closeMobile();
    });
  })();
</script>
