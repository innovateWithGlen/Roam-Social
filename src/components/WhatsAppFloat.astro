---
/**
 * WhatsAppFloat — persistent floating WhatsApp CTA.
 * Standard wa.me deep-link with a pre-filled message; pulsing ring,
 * hover tooltip, and full keyboard/ARIA support.
 */
const waUrl = "https://wa.me/918217733823?text=" +
  encodeURIComponent("Hi ROAM SOCIAL! I'd like to book the mobile bar for my event.");
---

<a href={waUrl}
   target="_blank"
   rel="noopener noreferrer"
   aria-label="Book ROAM SOCIAL on WhatsApp"
   class="wa-float group">
  <span class="wa-pulse" aria-hidden="true"></span>
  <i class="fa-brands fa-whatsapp relative text-2xl md:text-3xl" aria-hidden="true"></i>
  <span class="wa-tip">Book on WhatsApp</span>
</a>
