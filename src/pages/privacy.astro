---
import LegalLayout from "../layouts/LegalLayout.astro";

const title = "Privacy Policy | ROAM SOCIAL";
const description =
  "How ROAM SOCIAL collects, uses and protects your personal information when you enquire about our mobile bar services in Bengaluru.";
---

<LegalLayout title={title} description={description}>
  <h1>Privacy Policy</h1>
  <p class="legal-meta">Effective Date: October 15, 2026</p>

  <h2>1. Introduction</h2>
  <p>
    Welcome to Roam Social. This Privacy Policy outlines how we collect, use, and protect your
    personal information when you visit our website or enquire about our services. We are committed
    to maintaining your privacy and ensuring transparency in how your data is handled.
  </p>

  <h2>2. Information We Collect</h2>
  <p>We believe in minimal data collection. The only personal information we collect is the data
  you voluntarily provide to us when submitting an enquiry through our website&rsquo;s contact form.
  This typically includes:</p>
  <ul>
    <li>Name</li>
    <li>Email Address</li>
    <li>Phone Number (for WhatsApp communication)</li>
    <li>Event Details</li>
  </ul>

  <h2>3. How We Use Your Information</h2>
  <p>When you submit a contact form, your details are sent directly to
  <a href="mailto:support@roamsocial.in">support@roamsocial.in</a>. We use this information
  exclusively to:</p>
  <ul>
    <li>Respond to your enquiries and provide quotes.</li>
    <li>Communicate with you regarding your event booking via Email and WhatsApp.</li>
    <li>Coordinate logistics for our beverage catering services.</li>
  </ul>

  <h2>4. Data Storage and Sharing</h2>
  <p>We do not store your data in external marketing databases, nor do we track your browsing
  behavior across our site. Once your details are routed to our support email for communication
  purposes, no other data about you as a user is stored on our servers. We do not sell, trade, or
  rent your personal information to third parties under any circumstances.</p>

  <h2>5. Contact Us</h2>
  <p>If you have any questions regarding this Privacy Policy, please reach out to us at:</p>
  <p><strong>Email:</strong> <a href="mailto:support@roamsocial.in">support@roamsocial.in</a></p>
</LegalLayout>
